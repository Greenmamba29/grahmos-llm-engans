# Grahmos Environment Variables
# Copy this file to .env and fill in your actual values

# ===== Required API Keys =====

# Groq API Key (for LLM inference)
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (for embeddings)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Brave Search API Key
# Get it from: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# Serper API Key (for search, images, videos)
# Get it from: https://serper.dev/
SERPER_API=your_serper_api_key_here

# ===== Webflow Integration =====

# Allowed origins for CORS (comma-separated)
# Add your Webflow domain and production domain
ALLOWED_ORIGINS=https://grahmos.webflow.io,https://www.grahmos.com,https://grahmos.com,http://localhost:3000

# Webflow API Token (optional, for CMS integration)
# Get it from: Webflow Site Settings → Integrations → API Access
WEBFLOW_API_TOKEN=your_webflow_token_here

# Webflow Site ID (optional)
WEBFLOW_SITE_ID=your_site_id_here

# ===== Optional: Rate Limiting & Caching =====

# Upstash Redis (for rate limiting)
# Get it from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Upstash Vector (for semantic cache)
UPSTASH_VECTOR_REST_URL=your_upstash_vector_url
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token

# ===== Optional: Additional Integrations =====

# Portkey AI (for AI Gateway)
# Get it from: https://portkey.ai/
PORTKEY_API_KEY=your_portkey_api_key

# Fal.AI (for image generation)
# Get it from: https://fal.ai/
FAL_KEY=your_fal_api_key

# Spotify (for music integration)
# Get it from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Google Custom Search (optional alternative to Brave/Serper)
GOOGLE_SEARCH_API_KEY=your_google_api_key
GOOGLE_CX=your_custom_search_engine_id

# ===== Development =====

# Node environment
NODE_ENV=development

# Next.js telemetry (set to 1 to disable)
NEXT_TELEMETRY_DISABLED=1
